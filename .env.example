# Copie para .env.local e preencha. NUNCA coloque a chave service_role aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Liga os botões de contratação do plano Pro. Só ative depois de configurar o Mercado Pago (docs/BILLING.md).
VITE_BILLING_ENABLED=false

# Pagamento no cartão. Use false para esconder o botão (e grave CARD_ENABLED=false nos secrets do Supabase).
VITE_CARD_ENABLED=true

# Lembretes por notificação (docs/NOTIFICACOES.md). Chave PÚBLICA gerada com: npx web-push generate-vapid-keys
# Sem ela, a seção "Lembretes" não aparece.
VITE_VAPID_PUBLIC_KEY=

# Verificação anti-robô no login (docs/SEGURANCA.md). Chave PÚBLICA (Site key) do Cloudflare Turnstile.
# Sem ela, a verificação não aparece. Só ative o CAPTCHA no Supabase depois de publicar o site com esta chave.
VITE_TURNSTILE_SITE_KEY=
