# Copie para .env.local e preencha. NUNCA coloque a chave service_role aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Liga os botões de contratação do plano Pro. Só ative depois de configurar o Mercado Pago (docs/BILLING.md).
VITE_BILLING_ENABLED=false

# Pagamento no cartão. Use false para esconder o botão (e grave CARD_ENABLED=false nos secrets do Supabase).
VITE_CARD_ENABLED=true
